---
// The Google Tag Manager loader, for <head>. Renders only in a production build with a
// container id, so `astro dev` and builds without PUBLIC_GTM_ID send nothing to the site's
// GA4 property. Pair it with <GtmNoscript> at the start of <body>.
//
//   <Gtm id={import.meta.env.PUBLIC_GTM_ID} />
//
// is:inline keeps Astro from bundling and deferring the script: the dataLayer bootstrap has to
// run before anything calls track().
const { id } = Astro.props

const enabled = import.meta.env.PROD && Boolean(id)
if (enabled && !/^GTM-[A-Z0-9]+$/.test(id)) throw new Error(`Gtm: "${id}" is not a GTM container id (GTM-XXXXXXX)`)

const loader = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',${JSON.stringify(id)});`
---

{enabled && <script is:inline set:html={loader} />}

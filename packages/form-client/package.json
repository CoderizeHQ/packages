{
  "name": "@coderize/form-client",
  "version": "0.1.1",
  "description": "Browser client for the CoderizeDEV shared form handler (form-api-ses): submit, spam guard, reserved-key filter and file uploads",
  "keywords": [
    "forms",
    "coderize"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderizeDEV/coderize-platform.git",
    "directory": "packages/form-client"
  },
  "license": "UNLICENSED",
  "author": "Coderize",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "files": [
    "CHANGELOG.md",
    "errors.js",
    "fields.js",
    "guard.js",
    "index.d.ts",
    "index.js",
    "react.d.ts",
    "react.js",
    "result.js",
    "submit.js",
    "upload.js"
  ],
  "scripts": {
    "test": "vitest run && tsc -p test/types"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
